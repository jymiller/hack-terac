# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- App ---
APP_URL=http://localhost:3000
PORT=3000

# --- Neon Postgres (use the POOLED connection string) ---
DATABASE_URL=

# --- Stripe ---
# Sandbox/test keys (sk_test_ / pk_test_) for building.
# Test-mode charges do NOT count toward hackathon revenue.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint on Render.
STRIPE_WEBHOOK_SECRET=
# The ONE Payment Link submitted to the organizers. Live mode on event day.
STRIPE_PAYMENT_LINK=

# --- Terac (required to submit) ---
TERAC_API_KEY=
TERAC_BASE_URL=https://terac.com/api/external/v2

# --- Sponsor tracks ---
LINQ_API_KEY=
BAND_API_KEY=
SUPERSERVE_API_KEY=
PIONEER_API_KEY=
RENDER_API_KEY=
